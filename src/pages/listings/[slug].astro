---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import ReservationForm from '../../components/ReservationForm.astro';
import BedDouble from '@lucide/astro/icons/bed-double';
import Bath from '@lucide/astro/icons/bath';
import Users from '@lucide/astro/icons/users';
import Ruler from '@lucide/astro/icons/ruler';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import Check from '@lucide/astro/icons/check';
import Play from '@lucide/astro/icons/play';
import Pause from '@lucide/astro/icons/pause';
import Share2 from '@lucide/astro/icons/share-2';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map((listing) => ({
    params: { slug: listing.id },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const {
  title,
  location,
  tagline,
  heroImage,
  intro,
  description,
  facts,
  amenities,
  highlights,
  gallery,
  distances,
  activities,
  excursions,
  arrival,
  pricingNotes,
  cancellationPolicy,
  host,
  reviews,
  ratingAverage,
  ratingCount,
  coords,
  contactEmail,
} = listing.data;

// ponytail: hero carousel reuses the gallery images already in the schema
// instead of adding a dedicated "heroImages" field
const seenSlideSrc = new Set();
const heroSlides = [
  { src: heroImage, alt: title },
  ...gallery.map((g) => ({ src: g.src, alt: g.alt })),
]
  .filter((slide) => (seenSlideSrc.has(slide.src.src) ? false : seenSlideSrc.add(slide.src.src)))
  .slice(0, 6);
---

<Layout title={`${title} — ${location}`} description={tagline}>
  <section class="hero">
    <div class="hero-slides" id="hero-slides">
      {
        heroSlides.map((slide, i) => (
          <Image
            src={slide.src}
            alt={slide.alt}
            width={1900}
            priority={i === 0}
            class={`hero-slide${i === 0 ? ' is-active' : ''}`}
          />
        ))
      }
    </div>
    <div class="hero-controls">
      <button class="hero-icon-btn share-btn" type="button" aria-label="Link teilen">
        <Share2 size={17} />
      </button>
      {
        heroSlides.length > 1 && (
          <button class="hero-icon-btn" id="hero-autoplay-toggle" type="button" aria-pressed="true" aria-label="Automatischen Bildwechsel umschalten">
            <Pause size={17} class="icon-pause" />
            <Play size={17} class="icon-play" />
          </button>
        )
      }
    </div>
    <div class="hero-content">
      <div class="wrap">
        <span class="location">{location}</span>
        <h1>{title}</h1>
        <p class="tagline">{tagline}</p>
        <div class="cta-row">
          <a class="btn" href="#anfrage">Jetzt anfragen</a>
          <a class="btn btn-outline" href="#galerie">Galerie ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    const slides = [...document.querySelectorAll('.hero-slide')];
    const toggle = document.getElementById('hero-autoplay-toggle');
    let index = 0;
    let timer;

    function show(i) {
      slides[index]?.classList.remove('is-active');
      index = (i + slides.length) % slides.length;
      slides[index].classList.add('is-active');
    }

    function start() {
      if (slides.length < 2) return;
      timer = setInterval(() => show(index + 1), 5000);
    }

    function stop() {
      clearInterval(timer);
    }

    if (toggle) {
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) start();
      toggle.setAttribute('aria-pressed', String(!reduceMotion));

      toggle.addEventListener('click', () => {
        const playing = toggle.getAttribute('aria-pressed') === 'true';
        if (playing) {
          stop();
        } else {
          start();
        }
        toggle.setAttribute('aria-pressed', String(!playing));
      });
    }
  </script>

  <section class="tight">
    <div class="wrap intro-grid">
      <div>
        <p>{intro}</p>
        {description.map((p) => <p>{p}</p>)}
      </div>
      <div class="facts">
        <ul class="facts-list">
          <li><BedDouble class="icon" size={20} /> {facts.bedrooms} Schlafzimmer</li>
          <li><Bath class="icon" size={20} /> {facts.bathrooms} Bäder</li>
          <li><Users class="icon" size={20} /> Max. {facts.guests} Gäste</li>
          <li><Ruler class="icon" size={20} /> {facts.sizeSqm} m²</li>
        </ul>
        <a class="btn" href="#anfrage">Unverbindlich anfragen</a>
      </div>
    </div>
  </section>

  <section class="highlights">
    <div class="wrap">
      <p class="section-label">Warum hier buchen</p>
      <div class="highlight-grid">
        {
          highlights.map((h) => (
            <div class="highlight-card">
              <Image src={h.image} alt={h.title} width={400} height={300} />
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="galerie">
    <div class="wrap">
      <p class="section-label">Galerie</p>
      <Gallery images={gallery} />
    </div>
  </section>

  <section id="ausstattung" class="tight">
    <div class="wrap">
      <p class="section-label">Ausstattung</p>
      <ul class="amenities-grid">
        {amenities.map((a) => <li><Check class="icon" size={16} /> {a}</li>)}
      </ul>
    </div>
  </section>

  <section class="tight">
    <div class="wrap cta-banner">
      <div>
        <h2>Gefällt Ihnen {title}?</h2>
        <p>Fragen Sie unverbindlich Ihren Wunschzeitraum an.</p>
      </div>
      <div class="cta-row">
        <a class="btn" href="#anfrage">Jetzt anfragen</a>
        <button class="btn btn-outline share-btn" type="button" aria-label="Diese Unterkunft teilen">
          <Share2 size={16} /> Teilen
        </button>
      </div>
    </div>
  </section>

  {
    (distances || coords) && (
      <section id="lage" class="highlights">
        <div class="wrap">
          <p class="section-label"><MapPin class="icon" size={16} /> Lage &amp; Entfernungen</p>
          {coords && <div class="map-frame" id="map" data-lat={coords.lat} data-lng={coords.lng} data-label={title} />}
          {distances && (
            <ul class="amenities-grid" style="margin-top: 1.5rem;">
              {distances.map((d) => (
                <li>
                  {d.label}: {d.value}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  {
    coords && (
      <script>
        // @ts-nocheck
        import 'leaflet/dist/leaflet.css';
        import L from 'leaflet';

        const el = document.getElementById('map');
        const lat = Number(el.dataset.lat);
        const lng = Number(el.dataset.lng);
        const map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 19,
        }).addTo(map);

        const houseIcon = L.divIcon({
          className: 'map-house-marker',
          html: '<span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>',
          iconSize: [36, 36],
          iconAnchor: [18, 34],
        });

        L.marker([lat, lng], { icon: houseIcon }).addTo(map).bindPopup(el.dataset.label);
      </script>
    )
  }

  {
    (activities || excursions) && (
      <section class="tight">
        <div class="wrap">
          <p class="section-label">In der Nähe</p>
          {activities && <p>{activities.join(' · ')}</p>}
          {excursions && (
            <ul>
              {excursions.map((e) => <li>{e}</li>)}
            </ul>
          )}
        </div>
      </section>
    )
  }

  {
    arrival && (
      <section class="highlights">
        <div class="wrap">
          <p class="section-label">Anreise</p>
          {arrival.map((a) => (
            <p><strong>{a.mode}:</strong> {a.text}</p>
          ))}
        </div>
      </section>
    )
  }

  {
    (pricingNotes || cancellationPolicy) && (
      <section class="tight">
        <div class="wrap">
          <p class="section-label">Preise &amp; Bedingungen</p>
          {pricingNotes && (
            <ul>
              {pricingNotes.map((n) => <li>{n}</li>)}
            </ul>
          )}
          {cancellationPolicy && <p>{cancellationPolicy}</p>}
        </div>
      </section>
    )
  }

  {
    reviews && (
      <section class="highlights">
        <div class="wrap">
          <p class="section-label">
            Bewertungen
            {ratingAverage && ` — ${ratingAverage}/5`}
            {ratingCount && ` (${ratingCount} Bewertungen)`}
          </p>
          <div class="highlight-grid">
            {reviews.map((r) => (
              <div class="highlight-card">
                <h3>{r.author}</h3>
                <p>{r.text}</p>
                {r.reply && <p><em>Antwort des Gastgebers: {r.reply}</em></p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    host && (
      <section class="tight">
        <div class="wrap">
          <p class="section-label">Ihr Gastgeber</p>
          <div class="host-card">
            {host.image ? (
              <Image class="host-avatar" src={host.image} alt={host.name} width={90} height={90} />
            ) : (
              <div class="host-avatar-placeholder"><Users size={28} /></div>
            )}
            <div>
              <h3>{host.name}</h3>
              {host.languages && <p>{host.languages}</p>}
            </div>
          </div>
          {host.message && <p>{host.message}</p>}
        </div>
      </section>
    )
  }

  <section id="anfrage" class="booking">
    <div class="wrap booking-grid">
      <div class="booking-intro">
        <p class="section-label">Jetzt anfragen</p>
        <h2>Ihr Aufenthalt in {location}</h2>
        <p>Schreiben Sie uns Ihre Wunschtermine — wir melden uns zeitnah mit Verfügbarkeit und Preis zurück.</p>
        <p class="contact-line"><Mail size={16} /> {contactEmail}</p>
      </div>
      <ReservationForm contactEmail={contactEmail} title={title} maxGuests={facts.guests} />
    </div>
  </section>
</Layout>
