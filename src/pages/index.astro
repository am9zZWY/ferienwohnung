---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Search from '@lucide/astro/icons/search';
import BedDouble from '@lucide/astro/icons/bed-double';
import Users from '@lucide/astro/icons/users';

const listings = await getCollection('listings');
---

<Layout title="Ferienwohnungen am Gardasee" description="Ferienwohnungen am Gardasee direkt vom Gastgeber mieten.">
  <div class="page-hero wrap">
    <h1>Ferienwohnungen am Gardasee</h1>
    <p>Handverlesene Unterkünfte direkt am See — anfragen und den Urlaub planen.</p>
  </div>
  <div class="wrap">
    <div class="filter-bar">
      <label class="search-field">
        <Search size={18} />
        <input type="search" id="filter-search" placeholder="Name oder Ort suchen…" />
      </label>
      <label class="number-field">
        <BedDouble size={18} />
        <input type="number" id="filter-bedrooms" min="0" placeholder="Min. Schlafzimmer" />
      </label>
      <label class="number-field">
        <Users size={18} />
        <input type="number" id="filter-guests" min="0" placeholder="Min. Gäste" />
      </label>
    </div>

    <div class="listing-cards" id="listing-cards">
      {
        listings.map((listing) => (
          <a
            class="listing-card"
            href={`${import.meta.env.BASE_URL}listings/${listing.id}/`}
            data-title={listing.data.title.toLowerCase()}
            data-location={listing.data.location.toLowerCase()}
            data-bedrooms={listing.data.facts.bedrooms}
            data-guests={listing.data.facts.guests}
          >
            <Image src={listing.data.heroImage} alt={listing.data.title} width={600} height={450} />
            <div class="card-body">
              <span class="location">{listing.data.location}</span>
              <h3>{listing.data.title}</h3>
              <p>{listing.data.tagline}</p>
              <div class="card-facts">
                <span><BedDouble size={16} /> {listing.data.facts.bedrooms}</span>
                <span><Users size={16} /> {listing.data.facts.guests}</span>
              </div>
              <span class="card-cta">Details &amp; Anfrage →</span>
            </div>
          </a>
        ))
      }
    </div>
    <p class="no-results" id="no-results" hidden>Keine Unterkunft passt zu diesen Filtern.</p>
  </div>
</Layout>

<script>
  // @ts-nocheck
  const search = document.getElementById('filter-search');
  const bedrooms = document.getElementById('filter-bedrooms');
  const guests = document.getElementById('filter-guests');
  const cards = [...document.querySelectorAll('.listing-card')];
  const noResults = document.getElementById('no-results');

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    const minBedrooms = Number(bedrooms.value);
    const minGuests = Number(guests.value);
    let visible = 0;

    for (const card of cards) {
      const matches =
        (!q || card.dataset.title.includes(q) || card.dataset.location.includes(q)) &&
        Number(card.dataset.bedrooms) >= minBedrooms &&
        Number(card.dataset.guests) >= minGuests;
      card.hidden = !matches;
      if (matches) visible++;
    }
    noResults.hidden = visible > 0;
  }

  search.addEventListener('input', applyFilters);
  bedrooms.addEventListener('input', applyFilters);
  guests.addEventListener('input', applyFilters);
</script>
